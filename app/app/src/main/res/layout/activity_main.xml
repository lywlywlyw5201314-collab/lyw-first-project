<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 页面容器(四个页面切换) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ========== 页面 1: 记账 (Paste + Manual + Screenshot) ========== -->
        <ScrollView
            android:id="@+id/pageBook"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/dir_a_title" style="@style/SectionTitle" />

                <EditText
                    android:id="@+id/etPaste"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/paste_hint"
                    android:inputType="textMultiLine"
                    android:minLines="2" />

                <TextView
                    android:id="@+id/tvPasteNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="?android:textColorSecondary"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnParse"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="@string/btn_smart_parse" />

                    <Button
                        android:id="@+id/btnPickScreenshot"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="@string/btn_pick_screenshot" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvShotNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="?android:textColorSecondary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dir_a_manual"
                    style="@style/SectionTitle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etManualAmount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:hint="@string/hint_amount"
                        android:inputType="numberDecimal" />

                    <EditText
                        android:id="@+id/etManualMerchant"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:hint="@string/hint_merchant"
                        android:inputType="text" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnManualAdd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_manual_add" />
            </LinearLayout>
        </ScrollView>

        <!-- ========== 页面 2: 账单 (Ledger list + Stats + Search/Filter/CSV) ========== -->
        <ScrollView
            android:id="@+id/pageBill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/bill_title" style="@style/SectionTitle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/billSearch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/hint_bill_search" />

                    <Button
                        android:id="@+id/btnCsv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_csv"
                        android:layout_gravity="center_vertical" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/fCat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:entries="@array/category_entries" />

                    <Spinner
                        android:id="@+id/fTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:entries="@array/time_range_entries" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/stats_title"
                    style="@style/SectionTitle" />

                <TextView
                    android:id="@+id/tvStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ledger_title"
                    style="@style/SectionTitle" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvEntries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </ScrollView>

        <!-- ========== 页面 3: 规则 (Learned rules) ========== -->
        <ScrollView
            android:id="@+id/pageRules"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/rules_title" style="@style/SectionTitle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etRuleMerchant"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/hint_rule_merchant" />

                    <Spinner
                        android:id="@+id/spRuleCat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:entries="@array/category_entries" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnRuleSave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_rule_save" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/learned_rules_title"
                    style="@style/SectionTitle" />

                <TextView
                    android:id="@+id/tvLearned"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </ScrollView>

        <!-- ========== 页面 4: 分析 (Stats + AI Settings + Self-test + Listener) ========== -->
        <ScrollView
            android:id="@+id/pageStats"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/analytics_title" style="@style/SectionTitle" />

                <TextView
                    android:id="@+id/tvAnalytics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/dir_b_title" style="@style/SectionTitle" />

                <TextView
                    android:id="@+id/tvListenerStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="?android:textColorSecondary" />

                <Button
                    android:id="@+id/btnOpenListenerSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_open_listener" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/ai_title" style="@style/SectionTitle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <EditText
                        android:id="@+id/etLlmEndpoint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/hint_llm_endpoint"
                        android:singleLine="true" />
                    <EditText
                        android:id="@+id/etLlmKey"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/hint_llm_key"
                        android:singleLine="true" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <EditText
                        android:id="@+id/etLlmModel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/hint_llm_model"
                        android:singleLine="true" />
                    <Button
                        android:id="@+id/btnLlmSave"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_llm_save" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLlmStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="?android:textColorSecondary" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/self_test_title" style="@style/SectionTitle" />

                <Button
                    android:id="@+id/btnSelfTest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_run_self_test" />

                <TextView
                    android:id="@+id/tvSelfTestResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="?android:textColorSecondary" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- 底部四导航 -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="#F5F5F7"
        android:gravity="center"
        android:paddingTop="4dp">

        <Button
            android:id="@+id/tabBook"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/tab_book"
            android:textSize="11sp"
            android:background="?android:selectableItemBackground" />

        <Button
            android:id="@+id/tabBill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/tab_bill"
            android:textSize="11sp"
            android:background="?android:selectableItemBackground" />

        <Button
            android:id="@+id/tabRules"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/tab_rules"
            android:textSize="11sp"
            android:background="?android:selectableItemBackground" />

        <Button
            android:id="@+id/tabStats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/tab_stats"
            android:textSize="11sp"
            android:background="?android:selectableItemBackground" />
    </LinearLayout>
</LinearLayout>
