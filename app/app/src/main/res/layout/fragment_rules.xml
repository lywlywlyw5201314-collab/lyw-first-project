<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageRules"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView style="@style/PageTitle" android:text="@string/rules_title" />
        <TextView style="@style/PageSubtitle" android:text="@string/rules_subtitle" />

        <LinearLayout
            android:id="@+id/ruleAddCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/surface_secondary"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">
            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="+"
                android:textSize="24sp"
                android:textColor="@color/accent_primary"
                android:background="@color/surface_primary" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/section_add_rule" android:textSize="15sp"
                    android:textStyle="bold" android:textColor="@color/text_primary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="设置商户关键词，自动分类或忽略" android:textSize="12sp"
                    android:textColor="@color/text_secondary" android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="规则类型"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />
        <Spinner
            android:id="@+id/spRuleType"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/surface_secondary"
            android:entries="@array/rule_type_entries"
            android:contentDescription="规则类型" />

        <EditText
            android:id="@+id/etRuleMerchant"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_marginTop="14dp"
            android:hint="@string/hint_rule_merchant"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="目标分类"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />
        <Spinner
            android:id="@+id/spRuleCat"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/surface_secondary"
            android:entries="@array/category_entries" />

        <Button
            android:id="@+id/btnRuleSave"
            style="@style/BtnPrimary"
            android:layout_marginTop="14dp"
            android:text="@string/btn_rule_save" />

        <TextView
            style="@style/SectionTitle"
            android:text="已识别的支付信息" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="弹窗读取并确认过的每一笔(同一商户同金额合并显示)。点按一行: 改类型 / 丢弃此信息(以后不再记录) / 删除这条记录。"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />
        <LinearLayout
            android:id="@+id/llPaidItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface_primary"
            android:padding="14dp"
            android:minHeight="40dp" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/learned_rules_title" />
        <TextView
            android:id="@+id/tvLearned"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:lineSpacingExtra="6dp"
            android:textColor="@color/text_secondary"
            android:background="@color/surface_primary"
            android:padding="14dp" />
    </LinearLayout>
</ScrollView>
