<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageBook"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@color/surface_primary">

        <TextView style="@style/PageTitle" android:text="@string/book_title" />
        <TextView style="@style/PageSubtitle" android:text="@string/book_subtitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/surface_secondary"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:minHeight="72dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¥"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/accent_primary"
                android:layout_marginEnd="8dp" />
            <EditText
                android:id="@+id/etManualAmount"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/hint_amount"
                android:inputType="numberDecimal"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary" />
        </LinearLayout>

        <EditText
            android:id="@+id/etManualMerchant"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:hint="@string/hint_merchant"
            android:inputType="text" />

        <Button
            android:id="@+id/btnManualAdd"
            style="@style/BtnPrimary"
            android:layout_marginTop="18dp"
            android:text="@string/btn_manual_add" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                android:background="@color/surface_secondary" android:padding="14dp"
                android:layout_marginEnd="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="解析" android:textSize="20sp" android:textColor="@color/accent_primary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="粘贴支付通知" android:textSize="12sp"
                    android:textColor="@color/text_secondary" android:layout_marginTop="6dp"
                    android:gravity="center" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                android:background="@color/surface_secondary" android:padding="14dp"
                android:layout_marginEnd="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="截图" android:textSize="20sp" android:textColor="@color/accent_primary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="识别支付截图" android:textSize="12sp"
                    android:textColor="@color/text_secondary" android:layout_marginTop="6dp"
                    android:gravity="center" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                android:background="@color/surface_secondary" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="手动" android:textSize="20sp" android:textColor="@color/accent_primary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="手动录入" android:textSize="12sp"
                    android:textColor="@color/text_secondary" android:layout_marginTop="6dp"
                    android:gravity="center" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/SectionTitle" android:text="常用分类" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:gravity="center" android:layout_marginTop="10dp">
                <FrameLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/round_bg" android:gravity="center">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_gravity="center" android:src="@drawable/ic_cat_dining"
                        android:contentDescription="餐饮" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="餐饮" android:textSize="12sp"
                    android:textColor="@color/text_secondary" android:layout_marginTop="6dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:gravity="center" android:layout_marginTop="10dp">
                <FrameLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/round_bg" android:gravity="center">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_gravity="center" android:src="@drawable/ic_cat_shopping"
                        android:contentDescription="购物" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="购物" android:textSize="12sp"
                    android:textColor="@color/text_secondary" android:layout_marginTop="6dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:gravity="center" android:layout_marginTop="10dp">
                <FrameLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/round_bg" android:gravity="center">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_gravity="center" android:src="@drawable/ic_cat_transport"
                        android:contentDescription="交通" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="交通" android:textSize="12sp"
                    android:textColor="@color/text_secondary" android:layout_marginTop="6dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:gravity="center" android:layout_marginTop="10dp">
                <FrameLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/round_bg" android:gravity="center">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_gravity="center" android:src="@drawable/ic_cat_other"
                        android:contentDescription="其他" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="其他" android:textSize="12sp"
                    android:textColor="@color/text_secondary" android:layout_marginTop="6dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/SectionTitle" android:text="@string/section_parse" />
        <EditText
            android:id="@+id/etPaste"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:gravity="top"
            android:hint="@string/paste_hint"
            android:inputType="textMultiLine" />
        <TextView
            android:id="@+id/tvPasteNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="6dp"
            android:visibility="gone" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">
            <Button
                android:id="@+id/btnParse"
                style="@style/BtnPrimary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/btn_smart_parse" />
            <Button
                android:id="@+id/btnPickScreenshot"
                style="@style/BtnSecondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/btn_pick_screenshot" />
        </LinearLayout>
        <TextView
            android:id="@+id/tvShotNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="8dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
