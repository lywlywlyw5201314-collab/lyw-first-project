<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- §3.1: 删掉没用到的 INTERNET。证据: 全工程 .kt 源码 0 处网络调用(无 java.net/HttpURLConnection/Socket/okhttp/retrofit),
         依赖里也没有任何网络库; 设备 dumpsys 取证见 docs/。POST_NOTIFICATIONS 是 TestCommandReceiver 发测试通知必需的, 保留。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NotifyLedger">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".NotificationLedgerService"
            android:exported="true"
            android:label="@string/notify_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".TestCommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.notifyledger.TEST_PASTE" />
                <action android:name="com.example.notifyledger.TEST_OCR" />
                <action android:name="com.example.notifyledger.TEST_PAYMENT_NOTIFICATION" />
                <action android:name="com.example.notifyledger.TEST_NONPAY" />
            </intent-filter>
        </receiver>

    </application>

</manifest>